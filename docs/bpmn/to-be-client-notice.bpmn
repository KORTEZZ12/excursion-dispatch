<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0" id="Definitions_ClientNotice" targetNamespace="http://bpmn.io/schema/bpmn" exporter="excursion-dispatch" exporterVersion="0.4">
  <bpmn:collaboration id="Collaboration_ClientNotice">
    <bpmn:participant id="P_Client" name="Клиент (Telegram, MAX или WhatsApp)" />
    <bpmn:participant id="P_Disp" name="Диспетчер экскурсий" processRef="client-notice" />
    <bpmn:messageFlow id="M1" sourceRef="A_Send" targetRef="P_Client" name="отписка с контактом гида" />
    <bpmn:messageFlow id="M2" sourceRef="A_Notify" targetRef="P_Client" name="контакт нового гида" />
  </bpmn:collaboration>
  <bpmn:process id="client-notice" name="Отписка клиенту" isExecutable="true">
    <bpmn:laneSet id="LaneSet_client_notice">
      <bpmn:lane id="L_Admin" name="Дежурный администратор">
        <bpmn:flowNodeRef>A_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_System" name="Система">
        <bpmn:flowNodeRef>S_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_AllSet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EBG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Assigned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_NotifyAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_AllNotified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EBG2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Changed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Begun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Start" name="Группы по заявке созданы">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="S_Time" name="Время подготовки отписки">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="S_Time_def"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">=noticeAt</bpmn:timeDate></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="S_Check" name="Проверить, назначены ли гиды">
      <bpmn:extensionElements><zeebe:taskDefinition type="check-guides-assigned" /></bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="S_AllSet" name="Все гиды назначены?" default="F5">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="S_EBG" name="Ждать гидов">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="S_Assigned" name="Все гиды назначены">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="S_Assigned_def" messageRef="Msg_AllAssigned" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="S_Deadline" name="Крайний срок отписки">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="S_Deadline_def"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">=noticeDeadline</bpmn:timeDate></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="S_Ready" name="Можно отправлять">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A_Send" name="Отправить отписку клиенту">
      <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition externalReference="admin-panel/notices" /><zeebe:assignmentDefinition candidateGroups="duty-admin" /></bpmn:extensionElements>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_Late" name="Не отправлено к сроку" attachedToRef="A_Send" cancelActivity="false">
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_Late_def"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">=noticeDeadline</bpmn:timeDate></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="S_NotifyAll" name="Создать эскалацию «Отписка не отправлена к сроку»">
      <bpmn:extensionElements><zeebe:taskDefinition type="create-escalation" /><zeebe:taskHeaders><zeebe:header key="reason" value="NOTICE_NOT_SENT" /><zeebe:header key="audience" value="all-admins" /></zeebe:taskHeaders></bpmn:extensionElements>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="S_AllNotified" name="Эскалация у всех администраторов">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="S_Wait" name="Ждать изменений">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="S_EBG2" name="До начала экскурсии">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="S_Changed" name="Гид сменился">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="S_Changed_def" messageRef="Msg_GuideChanged" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="A_Notify" name="Сообщить клиенту о новом гиде">
      <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition externalReference="admin-panel/notices" /><zeebe:assignmentDefinition candidateGroups="duty-admin" /></bpmn:extensionElements>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="S_Begun" name="Экскурсия началась">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:timerEventDefinition id="S_Begun_def"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">=startAt</bpmn:timeDate></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="S_End" name="Отписка больше не нужна">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="ES" name="Заявка изменена или отменена" triggeredByEvent="true">
            <bpmn:startEvent id="ES_Start" name="Заявка изменена или отменена">
        <bpmn:outgoing>F20</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ES_Start_def" messageRef="Msg_Changed" />
      </bpmn:startEvent>
            <bpmn:serviceTask id="ES_Re" name="Пересоздать отписку для активной заявки">
        <bpmn:extensionElements><zeebe:taskDefinition type="reschedule-notice" /></bpmn:extensionElements>
        <bpmn:incoming>F20</bpmn:incoming>
        <bpmn:outgoing>F21</bpmn:outgoing>
      </bpmn:serviceTask>
            <bpmn:endEvent id="ES_End" name="Отписка пересоздана или не нужна">
        <bpmn:incoming>F21</bpmn:incoming>
      </bpmn:endEvent>
            <bpmn:sequenceFlow id="F20" sourceRef="ES_Start" targetRef="ES_Re" />
            <bpmn:sequenceFlow id="F21" sourceRef="ES_Re" targetRef="ES_End" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="F1" sourceRef="S_Start" targetRef="S_Time" />
    <bpmn:sequenceFlow id="F2" sourceRef="S_Time" targetRef="S_Check" />
    <bpmn:sequenceFlow id="F3" sourceRef="S_Check" targetRef="S_AllSet" />
    <bpmn:sequenceFlow id="F4" sourceRef="S_AllSet" targetRef="S_Ready" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=allGuidesAssigned</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="S_AllSet" targetRef="S_EBG" name="нет" />
    <bpmn:sequenceFlow id="F6" sourceRef="S_EBG" targetRef="S_Assigned" />
    <bpmn:sequenceFlow id="F7" sourceRef="S_EBG" targetRef="S_Deadline" />
    <bpmn:sequenceFlow id="F8" sourceRef="S_Assigned" targetRef="S_Ready" />
    <bpmn:sequenceFlow id="F9" sourceRef="S_Deadline" targetRef="S_Ready" />
    <bpmn:sequenceFlow id="F10" sourceRef="S_Ready" targetRef="A_Send" />
    <bpmn:sequenceFlow id="F11" sourceRef="B_Late" targetRef="S_NotifyAll" />
    <bpmn:sequenceFlow id="F12" sourceRef="S_NotifyAll" targetRef="S_AllNotified" />
    <bpmn:sequenceFlow id="F13" sourceRef="A_Send" targetRef="S_Wait" />
    <bpmn:sequenceFlow id="F14" sourceRef="S_Wait" targetRef="S_EBG2" />
    <bpmn:sequenceFlow id="F15" sourceRef="S_EBG2" targetRef="S_Changed" />
    <bpmn:sequenceFlow id="F16" sourceRef="S_Changed" targetRef="A_Notify" />
    <bpmn:sequenceFlow id="F17" sourceRef="A_Notify" targetRef="S_Wait" />
    <bpmn:sequenceFlow id="F18" sourceRef="S_EBG2" targetRef="S_Begun" />
    <bpmn:sequenceFlow id="F19" sourceRef="S_Begun" targetRef="S_End" />
  </bpmn:process>
  <bpmn:message id="Msg_AllAssigned" name="all-guides-assigned">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=bookingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_GuideChanged" name="guide-changed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=bookingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Changed" name="booking-changed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=bookingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_ClientNotice">
      <bpmndi:BPMNShape id="P_Client_di" bpmnElement="P_Client" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="2420" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Disp_di" bpmnElement="P_Disp" isHorizontal="true">
        <dc:Bounds x="160" y="170" width="2420" height="640" />

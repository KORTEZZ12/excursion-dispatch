        <dc:Bounds x="2300" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_End_di" bpmnElement="C_End">
        <dc:Bounds x="2492" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Start_di" bpmnElement="A_Start">
        <dc:Bounds x="412" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Create_di" bpmnElement="A_Create">
        <dc:Bounds x="540" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_CRM_di" bpmnElement="A_CRM">
        <dc:Bounds x="565" y="415" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Post_di" bpmnElement="A_Post">
        <dc:Bounds x="700" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_EBG_di" bpmnElement="A_EBG">
        <dc:Bounds x="885" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Reply_di" bpmnElement="A_Reply">
        <dc:Bounds x="1052" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_NoReply_di" bpmnElement="A_NoReply">
        <dc:Bounds x="988" y="422" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Personal_di" bpmnElement="A_Personal">
        <dc:Bounds x="1180" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Merge_di" bpmnElement="A_Merge" isMarkerVisible="true">
        <dc:Bounds x="1365" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Assign_di" bpmnElement="A_Assign">
        <dc:Bounds x="1500" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Evening_di" bpmnElement="A_Evening">
        <dc:Bounds x="1692" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_DM_di" bpmnElement="A_DM">
        <dc:Bounds x="1820" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_SendNotice_di" bpmnElement="A_SendNotice">
        <dc:Bounds x="1980" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_End_di" bpmnElement="A_End">
        <dc:Bounds x="2172" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Ann_P3_di" bpmnElement="A_Ann_P3">
        <dc:Bounds x="1475" y="405" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Ann_N1_di" bpmnElement="A_Ann_N1">
        <dc:Bounds x="1955" y="405" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Start_di" bpmnElement="G_Start">
        <dc:Bounds x="732" y="612" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Seen_di" bpmnElement="G_Seen" isMarkerVisible="true">
        <dc:Bounds x="885" y="605" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Reply_di" bpmnElement="G_Reply">
        <dc:Bounds x="1020" y="590" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Missed_di" bpmnElement="G_Missed">
        <dc:Bounds x="1052" y="732" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Wait_di" bpmnElement="G_Wait">
        <dc:Bounds x="1852" y="612" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Time_di" bpmnElement="G_Time">
        <dc:Bounds x="2172" y="612" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Meet_di" bpmnElement="G_Meet">
        <dc:Bounds x="2300" y="590" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Lead_di" bpmnElement="G_Lead">
        <dc:Bounds x="2460" y="590" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_End_di" bpmnElement="G_End">
        <dc:Bounds x="2652" y="612" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Ann_P1_di" bpmnElement="G_Ann_P1">
        <dc:Bounds x="675" y="715" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Ann_P2_di" bpmnElement="G_Ann_P2">
        <dc:Bounds x="1955" y="715" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_C1_di" bpmnElement="F_C1">
        <di:waypoint x="288" y="130" />
        <di:waypoint x="380" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_C2_di" bpmnElement="F_C2">
        <di:waypoint x="480" y="130" />
        <di:waypoint x="2012" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_C3_di" bpmnElement="F_C3">
        <di:waypoint x="2048" y="130" />
        <di:waypoint x="2300" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_C4_di" bpmnElement="F_C4">
        <di:waypoint x="2400" y="130" />
        <di:waypoint x="2492" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A1_di" bpmnElement="F_A1">
        <di:waypoint x="448" y="320" />
        <di:waypoint x="540" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A2_di" bpmnElement="F_A2">
        <di:waypoint x="640" y="320" />
        <di:waypoint x="700" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A3_di" bpmnElement="F_A3">
        <di:waypoint x="800" y="320" />
        <di:waypoint x="885" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A4_di" bpmnElement="F_A4">
        <di:waypoint x="935" y="320" />
        <di:waypoint x="1052" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A5_di" bpmnElement="F_A5">
        <di:waypoint x="910" y="345" />
        <di:waypoint x="910" y="440" />
        <di:waypoint x="988" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A6_di" bpmnElement="F_A6">
        <di:waypoint x="1024" y="440" />
        <di:waypoint x="1180" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A7_di" bpmnElement="F_A7">
        <di:waypoint x="1088" y="320" />
        <di:waypoint x="1365" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_A8_di" bpmnElement="F_A8">

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AsIs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="excursion-dispatch" exporterVersion="0.1">
  <bpmn:collaboration id="Collaboration_AsIs">
    <bpmn:participant id="P_Client" name="Клиент" processRef="Process_Client" />
    <bpmn:participant id="P_Admin" name="Администратор" processRef="Process_Admin" />
    <bpmn:participant id="P_Guide" name="Гид" processRef="Process_Guide">
      <bpmn:participantMultiplicity minimum="2" maximum="100" />
    </bpmn:participant>
    <bpmn:messageFlow id="M_1" sourceRef="C_Call" targetRef="A_Start" name="звонок" />
    <bpmn:messageFlow id="M_2" sourceRef="A_Post" targetRef="G_Start" name="сообщение в общем чате" />
    <bpmn:messageFlow id="M_3" sourceRef="G_Reply" targetRef="A_Reply" name="отклик" />
    <bpmn:messageFlow id="M_4" sourceRef="A_DM" targetRef="G_Wait" name="личное сообщение" />
    <bpmn:messageFlow id="M_5" sourceRef="A_SendNotice" targetRef="C_Notice" name="отписка" />
    <bpmn:messageFlow id="M_6" sourceRef="C_Come" targetRef="G_Meet" name="оплата наличными или переводом" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Client" name="Клиент: запись на экскурсию" isExecutable="false">
    <bpmn:startEvent id="C_Start" name="Нужна экскурсия">
      <bpmn:outgoing>F_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="C_Call" name="Позвонить администратору">
      <bpmn:incoming>F_C1</bpmn:incoming>
      <bpmn:outgoing>F_C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="C_Notice" name="Отписка получена">
      <bpmn:incoming>F_C2</bpmn:incoming>
      <bpmn:outgoing>F_C3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_Notice_def" messageRef="Msg_Notice" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="C_Come" name="Прийти к месту сбора и оплатить">
      <bpmn:incoming>F_C3</bpmn:incoming>
      <bpmn:outgoing>F_C4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="C_End" name="Экскурсия проведена">
      <bpmn:incoming>F_C4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_C1" sourceRef="C_Start" targetRef="C_Call" />
    <bpmn:sequenceFlow id="F_C2" sourceRef="C_Call" targetRef="C_Notice" />
    <bpmn:sequenceFlow id="F_C3" sourceRef="C_Notice" targetRef="C_Come" />
    <bpmn:sequenceFlow id="F_C4" sourceRef="C_Come" targetRef="C_End" />
  </bpmn:process>
  <bpmn:process id="Process_Admin" name="Администратор: заявка и поиск гида" isExecutable="false">
    <bpmn:startEvent id="A_Start" name="Звонок клиента">
      <bpmn:outgoing>F_A1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="A_Start_def" messageRef="Msg_Call" />
    </bpmn:startEvent>
    <bpmn:task id="A_Create" name="Уточнить детали и создать заявку в CRM">
      <bpmn:incoming>F_A1</bpmn:incoming>
      <bpmn:outgoing>F_A2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DO_CRM"><bpmn:targetRef>A_CRM</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataStoreReference id="A_CRM" name="CRM" />
    <bpmn:task id="A_Post" name="Опубликовать группу в чате гидов">
      <bpmn:incoming>F_A2</bpmn:incoming>
      <bpmn:outgoing>F_A3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="A_EBG" name="Ждать отклик">
      <bpmn:incoming>F_A3</bpmn:incoming>
      <bpmn:outgoing>F_A4</bpmn:outgoing>
      <bpmn:outgoing>F_A5</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="A_Reply" name="Гид откликнулся в чате">
      <bpmn:incoming>F_A4</bpmn:incoming>
      <bpmn:outgoing>F_A7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="A_Reply_def" messageRef="Msg_Reply" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="A_NoReply" name="Отклика долго нет">
      <bpmn:incoming>F_A5</bpmn:incoming>
      <bpmn:outgoing>F_A6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="A_NoReply_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="A_Personal" name="Найти гида лично: звонки и личные сообщения">
      <bpmn:incoming>F_A6</bpmn:incoming>
      <bpmn:outgoing>F_A8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_Merge" name="Гид найден">
      <bpmn:incoming>F_A7</bpmn:incoming>
      <bpmn:incoming>F_A8</bpmn:incoming>
      <bpmn:outgoing>F_A9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_Assign" name="Закрепить гида за группой">
      <bpmn:incoming>F_A9</bpmn:incoming>
      <bpmn:outgoing>F_A10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="A_Evening" name="Вечер накануне">
      <bpmn:incoming>F_A10</bpmn:incoming>
      <bpmn:outgoing>F_A11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="A_Evening_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="A_DM" name="Написать гиду группы на завтра">
      <bpmn:incoming>F_A11</bpmn:incoming>
      <bpmn:outgoing>F_A12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_SendNotice" name="Отправить клиенту отписку">
      <bpmn:incoming>F_A12</bpmn:incoming>
      <bpmn:outgoing>F_A13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A_End" name="Группа подготовлена">
      <bpmn:incoming>F_A13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_A1" sourceRef="A_Start" targetRef="A_Create" />
    <bpmn:sequenceFlow id="F_A2" sourceRef="A_Create" targetRef="A_Post" />
    <bpmn:sequenceFlow id="F_A3" sourceRef="A_Post" targetRef="A_EBG" />
    <bpmn:sequenceFlow id="F_A4" sourceRef="A_EBG" targetRef="A_Reply" />
    <bpmn:sequenceFlow id="F_A5" sourceRef="A_EBG" targetRef="A_NoReply" />
    <bpmn:sequenceFlow id="F_A6" sourceRef="A_NoReply" targetRef="A_Personal" />
    <bpmn:sequenceFlow id="F_A7" sourceRef="A_Reply" targetRef="A_Merge" />
    <bpmn:sequenceFlow id="F_A8" sourceRef="A_Personal" targetRef="A_Merge" />
    <bpmn:sequenceFlow id="F_A9" sourceRef="A_Merge" targetRef="A_Assign" />
    <bpmn:sequenceFlow id="F_A10" sourceRef="A_Assign" targetRef="A_Evening" />
    <bpmn:sequenceFlow id="F_A11" sourceRef="A_Evening" targetRef="A_DM" />
    <bpmn:sequenceFlow id="F_A12" sourceRef="A_DM" targetRef="A_SendNotice" />
    <bpmn:sequenceFlow id="F_A13" sourceRef="A_SendNotice" targetRef="A_End" />
    <bpmn:textAnnotation id="A_Ann_P3">
      <bpmn:text>П3: администратор не всегда на связи, когда гиду нужно уточнить детали</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_Ann_N1">
      <bpmn:text>Н1: ручная рассылка каждый вечер, растёт с числом гидов</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_P3" sourceRef="A_Ann_P3" targetRef="A_Assign" />
    <bpmn:association id="As_N1" sourceRef="A_Ann_N1" targetRef="A_DM" />
  </bpmn:process>
  <bpmn:process id="Process_Guide" name="Гид: от сообщения в чате до экскурсии" isExecutable="false">
    <bpmn:startEvent id="G_Start" name="Сообщение о группе в чате">
      <bpmn:outgoing>F_G1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="G_Start_def" messageRef="Msg_ChatPost" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G_Seen" name="Увидел и свободен?">
      <bpmn:incoming>F_G1</bpmn:incoming>
      <bpmn:outgoing>F_G2</bpmn:outgoing>
      <bpmn:outgoing>F_G3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="G_Reply" name="Откликнуться в чате">
      <bpmn:incoming>F_G2</bpmn:incoming>
      <bpmn:outgoing>F_G4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="G_Missed" name="Группа прошла мимо">
      <bpmn:incoming>F_G3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="G_Wait" name="Получен список групп на завтра">
      <bpmn:incoming>F_G4</bpmn:incoming>
      <bpmn:outgoing>F_G5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="G_Wait_def" messageRef="Msg_DM" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="G_Time" name="Время экскурсии">
      <bpmn:incoming>F_G5</bpmn:incoming>
      <bpmn:outgoing>F_G6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="G_Time_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="G_Meet" name="Встретить группу и принять оплату">
      <bpmn:incoming>F_G6</bpmn:incoming>
      <bpmn:outgoing>F_G7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="G_Lead" name="Провести экскурсию">
      <bpmn:incoming>F_G7</bpmn:incoming>
      <bpmn:outgoing>F_G8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="G_End" name="Экскурсия проведена">
      <bpmn:incoming>F_G8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_G1" sourceRef="G_Start" targetRef="G_Seen" />
    <bpmn:sequenceFlow id="F_G2" sourceRef="G_Seen" targetRef="G_Reply" name="да" />
    <bpmn:sequenceFlow id="F_G3" sourceRef="G_Seen" targetRef="G_Missed" name="нет" />
    <bpmn:sequenceFlow id="F_G4" sourceRef="G_Reply" targetRef="G_Wait" />
    <bpmn:sequenceFlow id="F_G5" sourceRef="G_Wait" targetRef="G_Time" />
    <bpmn:sequenceFlow id="F_G6" sourceRef="G_Time" targetRef="G_Meet" />
    <bpmn:sequenceFlow id="F_G7" sourceRef="G_Meet" targetRef="G_Lead" />
    <bpmn:sequenceFlow id="F_G8" sourceRef="G_Lead" targetRef="G_End" />
    <bpmn:textAnnotation id="G_Ann_P1">
      <bpmn:text>П1: сообщение теряется в ленте чата</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="G_Ann_P2">
      <bpmn:text>П2, П4: группы приходят сообщениями, своего расписания нет — легко забыть</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_P1" sourceRef="G_Ann_P1" targetRef="G_Seen" />
    <bpmn:association id="As_P2" sourceRef="G_Ann_P2" targetRef="G_Wait" />
  </bpmn:process>
  <bpmn:message id="Msg_Call" name="Звонок клиента" />
  <bpmn:message id="Msg_ChatPost" name="Сообщение о группе в чате" />
  <bpmn:message id="Msg_Reply" name="Отклик гида" />
  <bpmn:message id="Msg_DM" name="Группы на завтра" />
  <bpmn:message id="Msg_Notice" name="Отписка" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_AsIs">
      <bpmndi:BPMNShape id="P_Client_di" bpmnElement="P_Client" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="2740" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Admin_di" bpmnElement="P_Admin" isHorizontal="true">
        <dc:Bounds x="160" y="250" width="2740" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Guide_di" bpmnElement="P_Guide" isHorizontal="true">
        <dc:Bounds x="160" y="560" width="2740" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Start_di" bpmnElement="C_Start">
        <dc:Bounds x="252" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Call_di" bpmnElement="C_Call">
        <dc:Bounds x="380" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Notice_di" bpmnElement="C_Notice">
        <dc:Bounds x="2012" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
